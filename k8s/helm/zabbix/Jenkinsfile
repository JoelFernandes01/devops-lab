pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Validar Helm Chart Zabbix') {
            steps {
                sh 'helm lint k8s/helm/zabbix'
            }
        }
    }
}
