pipeline {
    agent any

    environment {
        CHART_DIR = 'k8s/helm/nginx'
        APP_NAME  = 'nginx-app'
    }

    stages {
        stage('1. Helm Lint & Sintaxe') {
            steps {
                script {
                    echo "🔍 Validando a estrutura do Helm Chart e values.yaml..."
                    sh "helm lint ${CHART_DIR}"
                }
            }
        }

        stage('2. Renderização de Templates') {
            steps {
                script {
                    echo "🧪 Validando a renderização dos manifestos YAML..."
                    sh "helm template ${APP_NAME} ${CHART_DIR} > /dev/null"
                }
            }
        }

        stage('3. Notificar ArgoCD') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "🚀 Commit validado no branch main!"
                    echo "O ArgoCD irá detectar a alteração e aplicar o HPA no cluster."
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline CI finalizada com sucesso!"
        }
        failure {
            echo "❌ Erro na validação do Helm Chart."
        }
    }
}
