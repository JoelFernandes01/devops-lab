pipeline {
    agent any

    environment {
        CHART_PATH = 'k8s/helm/monitoring'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Helm Lint & Validation') {
            steps {
                script {
                    echo "Validando sintaxe do Helm Chart na pasta ${CHART_PATH}..."
                    sh "helm lint ${CHART_PATH}"
                }
            }
        }

        stage('Helm Dry-Run Render') {
            steps {
                script {
                    echo "Simulando a renderização dos templates..."
                    sh "helm template test-release ${CHART_PATH} --debug"
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline concluída com sucesso! O ArgoCD pode sincronizar a stack de monitoramento."
        }
        failure {
            echo "Erro na validação do Chart. Verifique os logs acima."
        }
    }
}
