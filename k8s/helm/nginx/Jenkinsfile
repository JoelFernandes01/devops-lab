pipeline {
    agent any

    environment {
        CHART_DIR = 'k8s/helm/nginx'  // <--- Atualizado para o caminho completo no repositório
        APP_NAME  = 'nginx-app'
    }

    stages {
        stage('1. Helm Lint & Sintaxe') {
            steps {
                script {
                    echo "🔍 Validando a estrutura do Helm Chart e values.yaml..."
                    sh "helm lint ${CHART_DIR}"
                }
            }
        }

        stage('2. Dry-Run Kubernetes') {
            steps {
                script {
                    echo "🧪 Renderizando os templates e validando no K8s..."
                    sh "helm template ${CHART_DIR} > /tmp/rendered-${APP_NAME}.yaml"
                    sh "kubectl apply --dry-run=client -f /tmp/rendered-${APP_NAME}.yaml"
                }
            }
        }

        stage('3. Trigger ArgoCD') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "🚀 Commit validado com sucesso no branch main!"
                    echo "O ArgoCD irá sincronizar o HPA automaticamente no cluster."
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline finalizada com sucesso!"
        }
        failure {
            echo "❌ Erro na validação do Helm Chart."
        }
    }
}
