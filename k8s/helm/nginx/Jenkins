pipeline {
    agent any

    environment {
        CHART_DIR = 'nginx'
        APP_NAME  = 'nginx-app'
    }

    stages {
        stage('1. Checkout') {
            steps {
                checkout scm
            }
        }

        stage('2. Helm Lint & Sintaxe') {
            steps {
                script {
                    echo "🔍 Validando a estrutura do Helm Chart e values.yaml..."
                    sh "helm lint ${CHART_DIR}"
                }
            }
        }

        stage('3. Dry-Run Kubernetes') {
            steps {
                script {
                    echo "🧪 Renderizando os templates (Deployment, Service, HPA) e validando no K8s..."
                    sh "helm template ${CHART_DIR} > /tmp/rendered-${APP_NAME}.yaml"
                    sh "kubectl apply --dry-run=client -f /tmp/rendered-${APP_NAME}.yaml"
                }
            }
        }

        stage('4. Notificar / Trigger ArgoCD') {
            when {
                branch 'main'
            }
            steps {
                script {
                    echo "🚀 Commit aprovado no branch main!"
                    echo "O ArgoCD (Auto-Sync) irá detectar o repositório e sincronizar o HPA no cluster automaticamente."
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline finalizada com sucesso! O Helm Chart do NGINX está válido."
        }
        failure {
            echo "❌ Erro na validação do Helm Chart. Corrija o YAML antes do merge."
        }
    }
}
