pipeline {
    agent any

    environment {
        CHART_PATH = 'k8s/helm/monitoring'
    }

    stages {
        stage('Helm Lint & Validation') {
            steps {
                echo "Validando sintaxe do Helm Chart..."
                sh "helm lint ${CHART_PATH}"
            }
        }

        stage('Helm Dry-Run Render') {
            steps {
                echo "Simulando a renderização dos templates..."
                sh "helm template test-release ${CHART_PATH} --debug"
            }
        }
    }

    post {
        success {
            echo "Pipeline concluída com sucesso! O ArgoCD pode sincronizar a stack."
        }
        failure {
            echo "Erro na validação do Chart. Verifique os logs."
        }
    }
}
